# Скопируйте в .env и заполните при необходимости (файл .env в git не попадает)
# Сервер Matrix, подставляемый в форму входа
VITE_DEFAULT_SERVER=
# Запасной адрес lk-jwt-service для звонков, если сервер не сообщает его сам
VITE_LIVEKIT_SERVICE_URL=
# Куда «Написать разработчику» шлёт отзывы (по умолчанию https://jsmassenger.ru/api/feedback)
VITE_FEEDBACK_URL=
