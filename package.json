{
  "name": "jsmessenger",
  "version": "0.11.4",
  "description": "Matrix-мессенджер для macOS, Windows и Linux со звонками через LiveKit (MatrixRTC)",
  "license": "AGPL-3.0-or-later",
  "author": "JedySan",
  "repository": {
    "type": "git",
    "url": "https://github.com/JedySan/JsMessenger.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-licenses.mjs && node scripts/i18n-check.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "licenses": "node scripts/gen-licenses.mjs",
    "linux": "bash scripts/build-electron.sh linux",
    "electron:dev": "npm run electron:bundle && JSM_DEV_URL=http://localhost:1420 electron electron/dist/main.cjs",
    "windows": "bash scripts/build-electron.sh win",
    "electron:bundle": "node scripts/bundle-electron.mjs",
    "i18n": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "dompurify": "^3.4.17",
    "livekit-client": "^2.22.4",
    "lucide-react": "^1.57.0",
    "marked": "^18.1.1",
    "matrix-js-sdk": "^44.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/parser": "7.28.4",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "type": "module"
}
