# Скопируйте в /etc/jsmessenger-feedback.env и заполните (chmod 600)
PORT=8787
DATA_DIR=/var/lib/jsmessenger-feedback
SITE_URL=https://jsmessenger.ru
TZ=Asia/Ho_Chi_Minh

# вход в админку https://jsmessenger.ru/admin/
ADMIN_USER=admin
ADMIN_PASSWORD=

# куда слать письма о новых отзывах
MAIL_TO=JedySan@gmail.com
MAIL_FROM=JsMessenger <noreply@jsmessenger.ru>
# SMTP любого почтового ящика (для Gmail — пароль приложения, smtp.gmail.com:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# или локальный sendmail/postfix на сервере:
# SMTP_HOST=sendmail

# ---- JsMessenger Plus ----
# Расшифровка голосовых: whisper.cpp на этом сервере (ставится services/whisper/setup.sh)
WHISPER_URL=http://127.0.0.1:8178/inference
# …или любой сервис с API как у OpenAI (вместо WHISPER_URL):
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# WHISPER_API_KEY=
# WHISPER_API_MODEL=whisper-1
# Ключ шифрования токенов отложенной отправки (64 hex-символа: openssl rand -hex 32).
# Если не задан — создаётся файл relay.key рядом с данными.
# RELAY_KEY=
