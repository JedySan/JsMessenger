# Скопируйте в /etc/jsmessenger-feedback.env и заполните (chmod 600)
PORT=8787
DATA_DIR=/var/lib/jsmessenger-feedback
SITE_URL=https://jsmassenger.ru
TZ=Asia/Ho_Chi_Minh

# вход в админку https://jsmassenger.ru/admin/
ADMIN_USER=admin
ADMIN_PASSWORD=

# куда слать письма о новых отзывах
MAIL_TO=JedySan@gmail.com
MAIL_FROM=JsMessenger <noreply@jsmassenger.ru>
# SMTP любого почтового ящика (для Gmail — пароль приложения, smtp.gmail.com:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# или локальный sendmail/postfix на сервере:
# SMTP_HOST=sendmail
