# Сайт JsMessenger: статические файлы из папки site/ репозитория.
# Сертификат: certbot --nginx -d jsmessenger.ru -d www.jsmessenger.ru
# Проще: scripts/server-setup.sh ставит сайт целиком; старый адрес jsmassenger.ru обслуживается так же (без перенаправления — на него ходят старые версии приложения).
server {
    listen 80;
    listen [::]:80;
    server_name jsmessenger.ru www.jsmessenger.ru;
    return 301 https://jsmessenger.ru$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name jsmessenger.ru www.jsmessenger.ru;

    ssl_certificate     /etc/letsencrypt/live/jsmessenger.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jsmessenger.ru/privkey.pem;

    # www → без www
    if ($host = www.jsmessenger.ru) { return 301 https://jsmessenger.ru$request_uri; }

    root /var/www/jsmessenger.ru;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
    # отзывы из приложения и админка — сервис services/feedback (см. его README)
    location = /api/feedback {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        client_max_body_size 30m;
    }
    location /api/plus/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        client_max_body_size 25m; # голосовые на расшифровку
    }
    location /admin {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
    }
    # картинки и скрипты кэшируются, страница — всегда свежая
    location ~* \.(png|css|js)$ {
        expires 7d;
        add_header Cache-Control "public";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # шрифт — Google Fonts, список версий — api.github.com, установщики — github.com
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src https://api.github.com; img-src 'self' data:; script-src 'self'" always;

    gzip on;
    gzip_types text/css application/javascript;
}
