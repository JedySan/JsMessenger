# Сайт JsMessenger: статические файлы из папки site/ репозитория.
# Сертификат: certbot --nginx -d jsmassenger.ru -d www.jsmassenger.ru
server {
    listen 80;
    listen [::]:80;
    server_name jsmassenger.ru www.jsmassenger.ru;
    return 301 https://jsmassenger.ru$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name jsmassenger.ru www.jsmassenger.ru;

    ssl_certificate     /etc/letsencrypt/live/jsmassenger.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jsmassenger.ru/privkey.pem;

    # www → без www
    if ($host = www.jsmassenger.ru) { return 301 https://jsmassenger.ru$request_uri; }

    root /var/www/jsmassenger.ru;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
    # картинки и скрипты кэшируются, страница — всегда свежая
    location ~* \.(png|css|js)$ {
        expires 7d;
        add_header Cache-Control "public";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # шрифт — Google Fonts, список версий — api.github.com, установщики — github.com
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src https://api.github.com; img-src 'self' data:; script-src 'self'" always;

    gzip on;
    gzip_types text/css application/javascript;
}
